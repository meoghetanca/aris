#!/usr/bin/env node
/**
 * PreToolUse gate for anything that makes content public.
 *
 * Four things this makes impossible rather than merely discouraged:
 *
 *   1. publishing an asset while verification has not passed
 *   2. publishing after an asset changed but before verification was re-run
 *   3. publishing an asset carrying a claim with no evidence
 *   4. publishing before a human granted launchAuthorization
 *
 * A hook is a script. It cannot know that a human said yes out loud, so authority
 * lives in .aris/state.json, written by the aris commands and read here.
 *
 * launchAuthorization is set BY HAND, outside the chain. That is the one deliberate
 * human act this workflow keeps, and keeping it outside the automation is the point.
 *
 * If there is no .aris/state.json, this is not an aris project and the gate stays out
 * of the way entirely.
 *
 * Reads the hook payload on stdin, writes a permission decision on stdout.
 * Node only: no python, no other runtime.
 */
"use strict";
const fs = require("node:fs");
const path = require("node:path");

/**
 * Bash commands that push content outward. Reading and diffing are not gated.
 *
 * Written as alternatives with a verb, not as a list of tool names: gating every
 * mention of `git` or `aws` denies the reads and diffs this workflow runs constantly,
 * and a gate that cries wolf is a gate people route around with --force.
 *
 * `git push` needs the option dance because `git -C ../repo push` and
 * `git --git-dir=x push` were walking straight through a `\bgit\s+push\b` that only
 * matched the two words adjacent. Deliberately NOT `\bgit\b[^\n]*push`, which would
 * catch `git log --grep push`.
 */
const BASH_PUBLISH = new RegExp([
  // git, including global options before the subcommand
  // An option may carry its own argument: `git -C ../repo push`, `git -c k=v push`.
  // Each repetition is one option plus at most one non-option word, so `git log
  // --grep push` cannot reach `push` - `log` is not an option and stops the group.
  String.raw`\bgit\s+(?:-{1,2}[^\s]+\s+(?:[^-\s][^\s]*\s+)?)*push\b`,
  // github cli
  String.raw`\bgh\s+(?:pr\s+create|release\s+(?:create|upload)|gist\s+create)\b`,
  // package registries
  String.raw`\b(?:npm|yarn|pnpm|bun|cargo|gem|dotnet\s+nuget)\s+(?:publish|push)\b`,
  String.raw`\btwine\s+upload\b`,
  // container registries
  String.raw`\b(?:docker|podman|nerdctl)\s+push\b`,
  // hosting platforms: deploy or publish
  String.raw`\b(?:vercel|netlify|wrangler|surge|firebase|fly|flyctl|railway|heroku|amplify|gcloud\s+app)\b[^\n]*\b(?:deploy|publish)\b`,
  // object storage, outbound copies only
  String.raw`\baws\s+s3(?:api)?\s+(?:cp|sync|mv|put-object)\b`,
  String.raw`\bgsutil\s+(?:cp|rsync|mv)\b`,
  String.raw`\baz\s+storage\s+blob\s+(?:upload|upload-batch|sync)\b`,
  // generic file transfer to a remote host
  String.raw`\brsync\b[^\n]*@`,
  String.raw`\bscp\b[^\n]*@[^\s]*:`,
  String.raw`\bcurl\b[^\n]*(?:\s-T\b|--upload-file\b)`,
].join("|"));

// Artifact actions that only read or inspect. Everything else may put bytes online.
const ARTIFACT_READONLY = new Set([
  "read", "list", "list_types", "describe_type", "comments", "status",
  "list_assets", "read_asset", "list_files", "read_file", "read_db", "open",
]);

function deny(reason) {
  process.stdout.write(JSON.stringify({
    hookSpecificOutput: {
      hookEventName: "PreToolUse",
      permissionDecision: "deny",
      permissionDecisionReason: reason,
    },
  }));
  process.exit(0);
}
// Emit nothing and exit clean: no opinion, normal permission flow continues.
const allow = () => process.exit(0);

/** Walk up from cwd looking for .aris/state.json, so the gate works from subdirectories. */
function findState(start) {
  let d = path.resolve(start || process.cwd());
  for (;;) {
    const c = path.join(d, ".aris", "state.json");
    if (fs.existsSync(c)) return c;
    const p = path.dirname(d);
    if (p === d) return null;
    d = p;
  }
}

/**
 * Newest mtime under .aris/assets only.
 *
 * Deliberately NOT .aris/package: that directory is derived output, and
 * aris-launch.html is always written after the verification it reports. Counting it
 * would make every verification permanently stale one build later.
 */
function newestAssetMtime(root) {
  const d = path.join(root, ".aris", "assets");
  if (!fs.existsSync(d)) return 0;
  let newest = 0;
  for (const f of fs.readdirSync(d)) {
    // One stat, and a broken symlink must not throw: an exception here exits the hook
    // non-zero with no decision on stdout, which is the one failure mode a gate may
    // not have.
    let st;
    try { st = fs.statSync(path.join(d, f)); } catch { continue; }
    if (st.isFile()) newest = Math.max(newest, st.mtimeMs);
  }
  return newest;
}

const load = (p) => {
  try { return JSON.parse(fs.readFileSync(p, "utf8")); } catch { return null; }
};

let raw = "";
process.stdin.setEncoding("utf8");
process.stdin.on("data", (c) => (raw += c));
process.stdin.on("end", () => {
  let payload;
  try { payload = JSON.parse(raw); } catch { allow(); }

  const tool = payload.tool_name || "";
  const args = payload.tool_input || {};

  const statePath = findState(payload.cwd);
  if (!statePath) allow(); // not an aris project
  const root = path.dirname(path.dirname(statePath));

  let what;
  if (tool === "Bash") {
    if (!BASH_PUBLISH.test(String(args.command || ""))) allow();
    what = "a shell command that publishes";
  } else if (tool.startsWith("mcp__claude_ai_Gmail__")) {
    what = "an outbound email";
  } else if (tool === "Artifact") {
    if (ARTIFACT_READONLY.has(args.action || "publish")) allow();
    what = "an Artifact publish";
  } else {
    allow();
  }

  const state = load(statePath) || {};
  const verify = load(path.join(root, ".aris", "verification", "verify.json"));
  const claims = (load(path.join(root, ".aris", "assets", "claims.json")) || {}).claims || [];

  const prefix = `aris gate: ${what} was blocked.\n\n`;
  const tail =
    "\n\nThis gate reads .aris/state.json and .aris/verification/verify.json. " +
    "It is not asking for confirmation: fix the cause, do not retry.";

  if (!verify) deny(prefix + "Verification has never run. Run /aris-verify first." + tail);

  if (!verify.passed) {
    const blocking = verify.blockingIssues || [];
    const detail = blocking.slice(0, 8).map((b) => `  - ${b}`).join("\n") || "  (see verification/issues.json)";
    deny(prefix + "Verification failed:\n" + detail + tail);
  }

  // A missing or unparseable timestamp used to disable this check silently: `stamp`
  // became 0 or NaN and `if (stamp && ...)` was falsy, so a verify.json with no
  // timestamp published whatever it liked. No timestamp is not "fresh", it is
  // unknowable, and this gate exists to refuse the unknowable.
  const stamp = verify.timestamp ? Date.parse(verify.timestamp) : NaN;
  if (!Number.isFinite(stamp))
    deny(prefix +
      "verify.json carries no usable timestamp, so there is no way to tell whether it " +
      "describes the assets as they stand now. Re-run /aris-verify." + tail);
  if (newestAssetMtime(root) > stamp)
    deny(prefix +
      "An asset changed after the last verification run, so the green result describes " +
      "an older package. Re-run /aris-verify." + tail);

  const bad = claims.filter((c) => c.status === "unsupported").map((c) => c.id);
  if (bad.length)
    deny(prefix +
      `These claims have no evidence: ${bad.slice(0, 10).join(", ")}.\nEvery published claim ` +
      "must resolve to a source id. Cite them, soften them, or remove them." + tail);

  if (!state.launchAuthorization)
    deny(prefix +
      "launchAuthorization is false.\n\nThis is the one decision the workflow will not make " +
      "for you: publishing is public and irreversible. Review .aris/package/aris-launch.html, " +
      "then set launchAuthorization to true in .aris/state.json by hand." + tail);

  allow();
});
